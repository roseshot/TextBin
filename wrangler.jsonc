{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "textbin",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "ratelimits": [
    { "name": "READ_RATE_LIMITER", "namespace_id": "73140281", "simple": { "limit": 120, "period": 60 } },
    { "name": "WRITE_RATE_LIMITER", "namespace_id": "73140282", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    "TTL_SECONDS": 3600
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "durable_objects": {
    "bindings": [
      { "name": "BOARD", "class_name": "Board" }
    ]
  },
  "exports": {
    "Board": { "type": "durable-object", "storage": "sqlite" }
  }
}
